{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": ["1.0.0", "1.1.0"]
    },
    "scene_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "simulation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "status": {
      "enum": ["running", "complete", "failed"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code_revision": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        },
        "parameters": {
          "type": "object"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": ["id", "sha256"]
          }
        }
      },
      "required": ["code_revision", "dirty", "parameters", "inputs"]
    },
    "spatial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame": {
          "const": "ENU"
        },
        "units": {
          "const": "m"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "height_m": {
              "type": "number"
            },
            "vertical_datum": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["longitude", "latitude", "height_m", "vertical_datum"]
        },
        "bounds_m": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "max": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": ["min", "max"]
        },
        "georeferenced": {
          "type": "boolean"
        }
      },
      "required": ["frame", "units", "origin", "bounds_m"]
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "const": "s"
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "epoch": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["unit", "samples"]
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "enum": ["mesh", "scalar_field", "vector_field", "trajectories", "time_series"]
          },
          "format": {
            "enum": ["json", "glb", "npy", "trajectory_frames", "npy_frames"]
          },
          "asset": {
            "type": "string",
            "minLength": 1
          },
          "sampling": {
            "enum": ["static", "step", "linear"]
          },
          "field": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["name", "unit"]
          },
          "display": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "widget": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "capabilities": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": ["pick", "legend", "slice", "opacity"]
                }
              },
              "color_map": {
                "type": "string",
                "minLength": 1
              },
              "range": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": ["widget", "capabilities"]
          },
          "encoding": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "coordinate_frame": {
                "enum": ["ENU", "glTF-y-up"]
              },
              "dtype": {
                "enum": ["<f2", "<f4", "<f8"]
              },
              "shape": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "minItems": 2,
                "maxItems": 4
              },
              "axes": {
                "enum": ["YX", "CYX", "TYX", "TCYX"]
              },
              "origin_m": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "spacing_m": {
                "type": "array",
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              "sample_location": {
                "const": "cell_center"
              },
              "byte_order": {
                "const": "little"
              },
              "compression": {
                "const": "none"
              },
              "frame_assets": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "height_asset": {
                "type": "string",
                "minLength": 1
              },
              "height_dtype": {
                "enum": ["<f2", "<f4", "<f8"]
              },
              "mask_asset": {
                "type": "string",
                "minLength": 1
              },
              "mask_dtype": {
                "const": "|u1"
              },
              "mask_semantics": {
                "const": "invalid_nonzero"
              }
            },
            "allOf": [
              {
                "if": {
                  "required": ["height_asset"]
                },
                "then": {
                  "required": ["height_dtype"]
                }
              },
              {
                "if": {
                  "required": ["mask_asset"]
                },
                "then": {
                  "required": ["mask_dtype", "mask_semantics"]
                }
              }
            ]
          }
        },
        "required": ["id", "kind", "format", "asset", "sampling", "display"],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": ["scalar_field", "vector_field", "time_series"]
                }
              }
            },
            "then": {
              "required": ["field"]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "mesh"
                }
              }
            },
            "then": {
              "properties": {
                "sampling": {
                  "const": "static"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "trajectories"
                }
              }
            },
            "then": {
              "properties": {
                "sampling": {
                  "enum": ["step", "linear"]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "format": {
                  "const": "glb"
                }
              }
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "mesh"
                },
                "encoding": {
                  "required": ["coordinate_frame"],
                  "properties": {
                    "coordinate_frame": {
                      "const": "glTF-y-up"
                    }
                  }
                }
              },
              "required": ["encoding"]
            }
          },
          {
            "if": {
              "properties": {
                "format": {
                  "enum": ["npy", "npy_frames"]
                }
              }
            },
            "then": {
              "properties": {
                "kind": {
                  "enum": ["scalar_field", "vector_field"]
                },
                "encoding": {
                  "required": [
                    "coordinate_frame",
                    "dtype",
                    "shape",
                    "axes",
                    "origin_m",
                    "spacing_m",
                    "sample_location",
                    "byte_order",
                    "compression"
                  ],
                  "properties": {
                    "coordinate_frame": {
                      "const": "ENU"
                    }
                  }
                }
              },
              "required": ["encoding"]
            }
          },
          {
            "if": {
              "properties": {
                "format": {
                  "const": "trajectory_frames"
                }
              }
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "trajectories"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "format": {
                  "const": "npy_frames"
                }
              }
            },
            "then": {
              "properties": {
                "encoding": {
                  "required": ["frame_assets"]
                },
                "sampling": {
                  "enum": ["step", "linear"]
                }
              }
            }
          }
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "asset", "sha256", "media_type"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "asset": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "scene_id",
    "simulation",
    "run_id",
    "status",
    "created_at",
    "provenance",
    "spatial",
    "time",
    "layers"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UrbanWorldModel run manifest v1.0 / v1.1",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "layers": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0.0"
          }
        }
      },
      "then": {
        "properties": {
          "layers": {
            "items": {
              "properties": {
                "format": {
                  "const": "json"
                }
              },
              "not": {
                "required": ["encoding"]
              }
            }
          }
        }
      }
    }
  ]
}
