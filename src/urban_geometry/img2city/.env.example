# Img2City configuration -- copy to `.env` (git-ignored) and edit.
#
# `img2city.config` loads this file automatically (from the repo root, or the
# path in IMG2CITY_ENV_FILE); variables already exported in the shell win.
# Plain KEY=value lines (an `export ` prefix, quotes and # comments are
# accepted).  Keys are read by the transports at call time, never stored.
# Switching the AI model or provider is an edit HERE, not in the code:
# `img2city doctor` shows what the running configuration resolves to.

# =============================================================================
# 1. LLM agents (vision / spec / judge / learning stages)
# =============================================================================
# provider = how models are reached:
#   codex        OpenAI models via the local Codex CLI (ChatGPT subscription login)
#   openai       OpenAI Responses API                (needs OPENAI_API_KEY)
#   claude-sdk   Claude via the Claude Agent SDK / `claude login` (Pro/Max plan)
#   claude-api   Anthropic Messages API               (needs ANTHROPIC_API_KEY)
IMG2CITY_LLM_PROVIDER=codex

# one model for every role ...
IMG2CITY_MODEL=gpt-6-astra
# ... or per role (a value may pin its own provider as <provider>:<model>):
#IMG2CITY_VISION_MODEL=gpt-6-astra                 # look at photos: view/card picks, courtyards, glass, shopfronts
#IMG2CITY_SPEC_MODEL=gpt-6-astra                   # write / repair / refine building specs
#IMG2CITY_JUDGE_MODEL=claude-api:claude-sonnet-5   # checklist + pairwise judging
#IMG2CITY_LEARNING_MODEL=gpt-6-astra               # author new kit parts (library.grow)
#IMG2CITY_PHOTO_CARD_MODEL=                        # web photo upload: card pick (default: vision model)
#IMG2CITY_PHOTO_SPEC_MODEL=                        # web photo upload: spec     (default: spec model)

# reasoning effort for the OpenAI family (low | medium | high); per-call timeout (s)
IMG2CITY_LLM_REASONING=high
IMG2CITY_LLM_TIMEOUT=600

# one JSON receipt per model call (prompt, output, usage, image hashes)
#IMG2CITY_MODEL_LOG_DIR=./runs/model_calls

# =============================================================================
# 2. API keys and endpoints
# =============================================================================
# Google Maps Platform: Static Maps, Street View Static, Geocoding, Places (New)
GOOGLE_MAPS_API_KEY=

# provider openai, and the openai:* image-edit models below
OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1        # proxy / compatible gateway

# provider claude-api ONLY.  Leave empty for claude-sdk: if set, the key takes
# precedence over the `claude login` subscription and you pay API rates.
ANTHROPIC_API_KEY=
#ANTHROPIC_BASE_URL=

# gemini:* image-edit models (synth-views, facade-clean --clean)
GEMINI_API_KEY=

# local CLIs for the subscription providers (defaults: on PATH / the macOS app)
#IMG2CITY_CODEX=/Applications/Codex.app/Contents/Resources/codex
#IMG2CITY_CLAUDE_CLI=claude

# =============================================================================
# 3. Image-editing models (facade cleaning, synthetic views), tried in order
# =============================================================================
# <provider>:<model>, provider in {openai, gemini}; entries without a key are skipped
#IMG2CITY_IMAGE_EDIT_MODELS=openai:gpt-image-2,gemini:gemini-3.1-flash-image,gemini:gemini-2.5-flash-image

# =============================================================================
# 4. Machine paths and services (all optional; defaults shown)
# =============================================================================
#IMG2CITY_DATA_DIR=./data                 # generated areas
#IMG2CITY_RUNS_DIR=./runs                 # demo / harness runs
#IMG2CITY_CACHE_DIR=./.cache              # web app GLBs and pick maps, DreamSim weights
#IMG2CITY_PRIOR_DIR=./data/prior          # learned-prior dataset + param_model.pt
#IMG2CITY_BLENDER=/Applications/Blender.app/Contents/MacOS/Blender
#IMG2CITY_TORCH_PYTHON=/path/to/env/bin/python   # interpreter carrying the [ml] stack
#IMG2CITY_MCP_HOST=localhost              # BlenderMCP addon socket
#IMG2CITY_MCP_PORT=9876
#IMG2CITY_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# =============================================================================
# 5. Experiment switches
# =============================================================================
#IMG2CITY_ONESHOT_EXEMPLAR=0              # inject a typology exemplar into the one-shot spec prompt
#IMG2CITY_LEARNED_PARTS=                  # alternative parts_learned.py (isolated library copies for learning runs)
#IMG2CITY_SPEC_DIALECT=                   # alternative spec_dialect.json (same)
#IMG2CITY_TEST_BASE=http://localhost:8000 # live web app for tests/test_site_integration.py
