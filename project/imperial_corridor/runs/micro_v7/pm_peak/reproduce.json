{
  "controller": "traffic.corridor_reservations",
  "command": [
    "sumo",
    "-n",
    "network.net.xml.gz",
    "-r",
    "routes.rou.xml.gz",
    "--begin",
    "64080.0",
    "--end",
    "64799.5",
    "--step-length",
    ".1",
    "--seed",
    "42",
    "--time-to-teleport",
    "-1",
    "--collision.action",
    "warn",
    "--collision.check-junctions",
    "true",
    "--lateral-resolution",
    ".4",
    "--fcd-output",
    "pm_peak.fcd.xml.gz",
    "--device.fcd.period",
    ".5",
    "--fcd-output.acceleration",
    "true",
    "--fcd-output.distance",
    "true",
    "--summary-output",
    "pm_peak.summary.xml",
    "--collision-output",
    "pm_peak.collisions.xml",
    "--tripinfo-output",
    "pm_peak.trips.xml",
    "--no-step-log",
    "--duration-log.statistics",
    "true",
    "--precision",
    "4"
  ],
  "sumo_version": "1.28.0",
  "assumptions": [
    "regenerated actuated signals; original timings unavailable",
    "25% deterministic route sample by default, not count-calibrated",
    "120-second empty-network warmup",
    "bus routes without original service schedule; no timetable claims",
    "no jam teleportation; retain congestion instead",
    "exclusive junction reservations: experimental controller, not actual London signal operation"
  ]
}
